{
  "name": "dogeuni-dex-sdk",
  "version": "0.1.0",
  "description": "DogeUni DEX 协议纯函数：报价、payload 构造与解析、费用与金额换算（与 dogeuni-indexer 逐位一致，零依赖）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogeuni-org/dex-sdk.git"
  },
  "homepage": "https://github.com/dogeuni-org/dex-sdk#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "dogeuni-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2020 --clean --out-dir dist"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  }
}
